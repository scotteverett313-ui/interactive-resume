{
  "redirects": [
    {
      "source": "/partnershiplevels",
      "destination": "/work-with-me",
      "permanent": false
    },
    {
      "source": "/contact",
      "destination": "/work-with-me",
      "permanent": false
    },
    {
      "source": "/stopguessing",
      "destination": "/work-with-me",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/blog",
      "destination": "/notes",
      "permanent": false
    },
    {
